<Window x:Class="SpeederConfigApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SpeederConfigApp.Controls"
        xmlns:vm="clr-namespace:SpeederConfigApp.ViewModels"
        mc:Ignorable="d"
        Title="Speeder Config - 55 Lines Config Generator" 
        Height="840" Width="1280"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header & Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Status Message Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR / HEADER -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1e3a8a" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SPEEDER CONFIG" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border Background="#1e293b" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="55 Lines Master" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Modern Graphical Editor &amp; Formatter for config.txt" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📄 New Config" Command="{Binding NewConfigCommand}" Margin="0,0,8,0" ToolTip="Reset to safe default settings" />
                    <Button Content="📂 Open config.txt" Command="{Binding OpenConfigCommand}" Margin="0,0,8,0" ToolTip="Load and parse an existing config.txt" />
                    <Button Content="💾 Save" Command="{Binding SaveConfigCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" ToolTip="Save current configuration to config.txt" />
                    <Button Content="💾 Save As..." Command="{Binding SaveAsConfigCommand}" Margin="0,0,8,0" ToolTip="Save to a specific location" />
                    <Button Content="📋 Copy (55 Lines)" Command="{Binding CopyToClipboardCommand}" ToolTip="Copy all 55 generated lines to clipboard" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- STATUS / NOTICE BANNER -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentFilePath, StringFormat='File: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SPLIT CONTENT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Editor Columns -->
                <ColumnDefinition Width="3*" MinWidth="550" />
                <!-- Splitter -->
                <ColumnDefinition Width="6" />
                <!-- Preview & Inspection Column -->
                <ColumnDefinition Width="2*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Categorized Settings Navigation Tabs -->
            <Border Grid.Column="0" Margin="12">
                <TabControl x:Name="SettingsTabControl">
                    <!-- ================= TAB 1: SYSTEM & GENERAL ================= -->
                    <TabItem Header="⚙️ System &amp; Core">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,8,4">
                            <StackPanel>
                                <!-- Line 1: Master Toggle Key -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="240" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource LineBadge}"><TextBlock Text="LINE 1" Style="{StaticResource LineBadgeText}" /></Border>
                                                <TextBlock Text="Master Toggle Key" Style="{StaticResource SettingTitle}" />
                                            </StackPanel>
                                            <TextBlock Text="The virtual key code to globally disable or enable all hacks in speeder." Style="{StaticResource SettingDesc}" />
                                        </StackPanel>
                                        <controls:KeyPickerControl Grid.Column="1" KeyCode="{Binding Settings.MasterToggleKey, Mode=TwoWay}" />
                                    </Grid>
                                </Border>

                                <!-- Line 20: Driver Name -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="240" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource LineBadge}"><TextBlock Text="LINE 20" Style="{StaticResource LineBadgeText}" /></Border>
                                                <TextBlock Text="Driver Name" Style="{StaticResource SettingTitle}" />
                                            </StackPanel>
                                            <TextBlock Text="Must appear exactly as it does in Driver.ini." Style="{StaticResource SettingDesc}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding Settings.DriverName, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>

                                <!-- Line 29: Macro File Name -->
                                <Border Style="{StaticResource SettingCard}" ToolTip="Name of the .ini macro file located in the same directory as config.txt.">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="240" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource LineBadge}"><TextBlock Text="LINE 29" Style="{StaticResource LineBadgeText}" /></Border>
                                                <TextBlock Text="Macro File Name" Style="{StaticResource SettingTitle}" />
                                            </StackPanel>
                                            <TextBlock Text="Name of the .ini macro file located in the same directory as config.txt." Style="{StaticResource SettingDesc}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding Settings.MacroFileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name of the .ini macro file located in the same directory as config.txt." />
                                    </Grid>
                                </Border>

                                <!-- Line 30: Injected Keys Allowed -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource LineBadge}"><TextBlock Text="LINE 30" Style="{StaticResource LineBadgeText}" /></Border>
                                                <TextBlock Text="Allow Injected Controller / Virtual Keys" Style="{StaticResource SettingTitle}" />
                                            </StackPanel>
                                            <TextBlock Text="If 1, keys from a controller can trigger macros. Caution: Never let a macro press its initiating key!" Style="{StaticResource SettingDesc}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Content="Enable Injected Keys" IsChecked="{Binding Settings.InjectedKeysAllowed, Mode=TwoWay}" />
                                    </Grid>
                                </Border>

                                <!-- Line 34: Polling Interval -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="240" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource LineBadge}"><TextBlock Text="LINE 34" Style="{StaticResource LineBadgeText}" /></Border>
                                                <TextBlock Text="Polling Interval (Milliseconds)" Style="{StaticResource SettingTitle}" />
                                            </StackPanel>
                                            <TextBlock Text="How often to read nonessential addresses and perform basic functions (recommended 1000+ ms)." Style="{StaticResource SettingDesc}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBox Text="{Binding Settings.PollingIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Line 35: Memory Debug Monitor -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource LineBadge}"><TextBlock Text="LINE 35" Style="{StaticResource LineBadgeText}" /></Border>
                                                <TextBlock Text="Memory Read / Write Activity Log" Style="{StaticResource SettingTitle}" />
                                            </StackPanel>
                                            <TextBlock Text="If enabled (1), outputs memory read/write activity to verify Line 34 operation." Style="{StaticResource SettingDesc}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Content="Show Memory Activity" IsChecked="{Binding Settings.MemoryDebugEnabled, Mode=TwoWay}" />
                                    </Grid>
                                </Border>

                                <!-- Line 42: Kernel Input Setting -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="240" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource LineBadge}"><TextBlock Text="LINE 42" Style="{StaticResource LineBadgeText}" /></Border>
                                                <TextBlock Text="Kernel Input Setting" Style="{StaticResource SettingTitle}" />
                                            </StackPanel>
                                            <TextBlock Text="Controls kernel-level driver input for mouse/keyboard emulation." Style="{StaticResource SettingDesc}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding Settings.KernelInputSetting, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>

                                <!-- Line 44: Console Window Settings -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource LineBadge}"><TextBlock Text="LINE 44" Style="{StaticResource LineBadgeText}" /></Border>
                                                    <TextBlock Text="Console Window Settings" Style="{StaticResource SectionHeader}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0" />
                                                </StackPanel>
                                                <TextBlock Text="Controls the position, dimensions, colors, font, and window behavior of speeder's interactive command console." Style="{StaticResource SettingDesc}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Content="Enable Custom Console" IsChecked="{Binding Settings.ConsoleEnabled, Mode=TwoWay}" FontWeight="Bold" ToolTip="If disabled, Line 44 is left blank and speeder uses default console placement." />
                                        </Grid>

                                        <StackPanel Visibility="{Binding Settings.ConsoleEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <!-- Quick Presets Bar -->
                                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,4,0,10">
                                                <WrapPanel VerticalAlignment="Center">
                                                    <TextBlock Text="⚡ Quick Layout Presets: " VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                                    <Button Content="Top-Left Corner" Command="{Binding ApplyConsolePresetTopLeftCommand}" Margin="2" Padding="8,3" FontSize="11" />
                                                    <Button Content="Bottom-Right Corner" Command="{Binding ApplyConsolePresetBottomRightCommand}" Margin="2" Padding="8,3" FontSize="11" />
                                                    <Button Content="Transparent Terminal" Command="{Binding ApplyConsolePresetOverlayCommand}" Margin="2" Padding="8,3" FontSize="11" />
                                                </WrapPanel>
                                            </Border>

                                            <!-- Parameter 1-4: Window Position & Dimensions -->
                                            <TextBlock Text="1. Window Position &amp; Geometry" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,4" />
                                            <UniformGrid Columns="4" Margin="0,0,0,8">
                                                <StackPanel Margin="3">
                                                    <TextBlock Text="X Position (px)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBox Text="{Binding Settings.ConsolePosX, UpdateSourceTrigger=PropertyChanged}" ToolTip="Distance in pixels from the left edge of your screen (e.g. 0 or 20)." />
                                                    <TextBlock Text="Pixels from left" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="3">
                                                    <TextBlock Text="Y Position (px)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBox Text="{Binding Settings.ConsolePosY, UpdateSourceTrigger=PropertyChanged}" ToolTip="Distance in pixels from the top edge of your screen (e.g. 0 or 20)." />
                                                    <TextBlock Text="Pixels from top" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="3">
                                                    <TextBlock Text="Width (px)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBox Text="{Binding Settings.ConsoleWidth, UpdateSourceTrigger=PropertyChanged}" ToolTip="Width of the console window in pixels (default ~520)." />
                                                    <TextBlock Text="Window width" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="3">
                                                    <TextBlock Text="Height (px)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBox Text="{Binding Settings.ConsoleHeight, UpdateSourceTrigger=PropertyChanged}" ToolTip="Height of the console window in pixels (default ~380)." />
                                                    <TextBlock Text="Window height" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </UniformGrid>

                                            <!-- Parameter 5 & 10: Typography & Font -->
                                            <TextBlock Text="2. Typography &amp; Text Styling" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,4" />
                                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                                <StackPanel Margin="3">
                                                    <TextBlock Text="Font Size" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBox Text="{Binding Settings.ConsoleFontSize, UpdateSourceTrigger=PropertyChanged}" ToolTip="Font size of the text printed inside the console (e.g. 13 or 14)." />
                                                    <TextBlock Text="Size of log text in pt" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="3">
                                                    <TextBlock Text="Font Family (Optional)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBox Text="{Binding Settings.ConsoleFont, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name of any installed font, e.g. Consolas, Lucida Console, Arial, Courier New." />
                                                    <TextBlock Text="e.g. Consolas, Arial" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </UniformGrid>

                                            <!-- Parameter 6 & 7: Window Colors -->
                                            <TextBlock Text="3. Console Colors (Decimal RGB)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,4" />
                                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                                <StackPanel Margin="3">
                                                    <TextBlock Text="Background Color:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                                    <controls:ColorPickerControl ColorValue="{Binding Settings.ConsoleBgColor, Mode=TwoWay}" ToolTip="Background color in decimal RGB. 3618615 = dark gray, 0 = black." />
                                                    <TextBlock Text="Default 3618615 (Dark Gray)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="3">
                                                    <TextBlock Text="Text / Foreground Color:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                                    <controls:ColorPickerControl ColorValue="{Binding Settings.ConsoleTextColor, Mode=TwoWay}" ToolTip="Text color in decimal RGB. 16777215 = White, 65280 = Green." />
                                                    <TextBlock Text="Default 16777215 (White)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </UniformGrid>

                                            <!-- Parameter 8 & 9: Window Behavior Flags -->
                                            <TextBlock Text="4. Window Display Flags" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,4" />
                                            <WrapPanel Margin="0,2,0,8">
                                                <CheckBox Content="Transparent Window (1 = See-through, 0 = Opaque)" IsChecked="{Binding Settings.ConsoleTransparent, Mode=TwoWay}" Margin="3,0,20,4" ToolTip="When enabled, console background is transparent to avoid blocking your game view." />
                                                <CheckBox Content="Always On Top (1 = Topmost Window)" IsChecked="{Binding Settings.ConsoleAlwaysOnTop, Mode=TwoWay}" Margin="3,0,20,4" ToolTip="Keeps the console window on top of the game even when clicking in the game window." />
                                            </WrapPanel>

                                            <!-- Parameter Format Reference Callout -->
                                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,4">
                                                <StackPanel>
                                                    <TextBlock Text="📖 Line 44 Format Specification:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4" />
                                                    <TextBlock Text="X position | Y position | Width | Height | Font size | Background color | Text color | Transparent | Always on top | (Optional) Font" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="Example: 0|0|520|380|13|3618615|16777215|0|1|Consolas" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Raw String Override Option -->
                                            <Expander Header="Advanced: Raw String Override" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0">
                                                <StackPanel Margin="4,6,4,0">
                                                    <TextBlock Text="If you want to paste a raw custom string directly for Line 44, enter it below (leave empty to use the fields above):" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding Settings.ConsoleCustomOverride, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================= TAB 2: SPEED & VIEW ================= -->
                    <TabItem Header="🚀 Speed &amp; FOV">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,8,4">
                            <StackPanel>
                                <!-- Line 2: Movement Speed Multiplier -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource LineBadge}"><TextBlock Text="LINE 2" Style="{StaticResource LineBadgeText}" /></Border>
                                                    <TextBlock Text="Movement Speed Multiplier" Style="{StaticResource SettingTitle}" />
                                                </StackPanel>
                                                <TextBlock Text="Percentage multiplier. 1.05 = +5% speed, 1.10 = +10% speed." Style="{StaticResource SettingDesc}" />
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Text="{Binding Settings.MovementSpeedMultiplier, StringFormat='{}{0:0.##}', UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
                                        </Grid>
                                        <Slider Minimum="1.00" Maximum="1.50" Value="{Binding Settings.MovementSpeedMultiplier}" SmallChange="0.01" LargeChange="0.05" Margin="0,6,0,6" />
                                        <!-- Strict Server Warning Banner -->
                                        <Border Background="#2a1b18" BorderBrush="#7c2d12" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                            <TextBlock Text="⚠️ Server check for movement speed is strict. Values higher than 1.05 (+5%) may trigger detection or rubberbanding." FontSize="11" Foreground="#fdba74" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Line 3: Movement Speed Toggle Key -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="240" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource LineBadge}"><TextBlock Text="LINE 3" Style="{StaticResource LineBadgeText}" /></Border>
                                                <TextBlock Text="Movement Speed Toggle Key" Style="{StaticResource SettingTitle}" />
                                            </StackPanel>
                                            <TextBlock Text="Virtual key code to toggle speed boost on/off during gameplay." Style="{StaticResource SettingDesc}" />
                                        </StackPanel>
                                        <controls:KeyPickerControl Grid.Column="1" KeyCode="{Binding Settings.MovementSpeedToggleKey, Mode=TwoWay}" />
                                    </Grid>
                                </Border>

                                <!-- Line 21: Field of View (FOV) -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="180" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource LineBadge}"><TextBlock Text="LINE 21" Style="{StaticResource LineBadgeText}" /></Border>
                                                    <TextBlock Text="Field of View (Recommended over Max Zoom)" Style="{StaticResource SettingTitle}" />
                                                </StackPanel>
                                                <TextBlock Text="1 (or 0) is normal. Values LESS than 1 INCREASE field of view without adding fog! Can also be X|Y (e.g. 0.5|0.75)." Style="{StaticResource SettingDesc}" />
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Text="{Binding Settings.FieldOfView, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
                                        </Grid>
                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock Text="Quick Presets: " VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0" />
                                            <Button Content="1.0 (Normal)" Margin="2" Padding="6,2" FontSize="11" Command="{Binding SetDefaultFieldOfViewCommand}" CommandParameter="1" />
                                            <Button Content="0.75 (+25% View)" Margin="2" Padding="6,2" FontSize="11" Command="{Binding SetDefaultFieldOfViewCommand}" CommandParameter="0.75" />
                                            <Button Content="0.50 (+50% View)" Margin="2" Padding="6,2" FontSize="11" Command="{Binding SetDefaultFieldOfViewCommand}" CommandParameter="0.50" />
                                            <Button Content="0.5|0.75 (Aspect Ratio Split)" Margin="2" Padding="6,2" FontSize="11" Command="{Binding SetDefaultFieldOfViewCommand}" CommandParameter="0.5|0.75" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Line 4: Max Zoom Multiplier -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource LineBadge}"><TextBlock Text="LINE 4" Style="{StaticResource LineBadgeText}" /></Border>
                                                <TextBlock Text="Max Zoom Multiplier (Percentage)" Style="{StaticResource SettingTitle}" />
                                            </StackPanel>
                                            <TextBlock Text="1 = 2x zoom, 2 = 3x zoom, 0.50 = +50%. (Note: Increases fog. Line 21 FOV is recommended instead)." Style="{StaticResource SettingDesc}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding Settings.MaxZoomMultiplier, StringFormat='{}{0:0.##}', UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Line 5: Max Zoom Toggle Key -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="240" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource LineBadge}"><TextBlock Text="LINE 5" Style="{StaticResource LineBadgeText}" /></Border>
