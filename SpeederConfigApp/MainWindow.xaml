                                </Border>

                                <!-- Line 26: Cursor Offset Distance -->
                                <Border Style="{StaticResource SettingCard}" ToolTip="Cursor travel distance in pixels for resource targeting commands like 'tcg' and 'tcg*'.">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource LineBadge}"><TextBlock Text="LINE 26" Style="{StaticResource LineBadgeText}" /></Border>
                                                <TextBlock Text="Cursor Offset Distance (Pixels)" Style="{StaticResource SettingTitle}" />
                                            </StackPanel>
                                            <TextBlock Text="Cursor travel distance in pixels for resource targeting commands like 'tcg' and 'tcg*'." Style="{StaticResource SettingDesc}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding Settings.WaymarkCursorOffsetPx, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" ToolTip="Cursor travel distance in pixels for resource targeting commands like 'tcg' and 'tcg*'." />
                                    </Grid>
                                </Border>

                                <!-- Waymarks Reference Guide -->
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="📖 Quick Reference &amp; Console Commands" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="-record 9999,30  → Records waypoints automatically or manually with Line 27 key" FontFamily="Consolas" FontSize="11.5" Foreground="#38bdf8" />
                                        <TextBlock Text="-tw* Recorded Waymarks.ini  → Follows waypoints sequentially" FontFamily="Consolas" FontSize="11.5" Foreground="#a1a1aa" />
                                        <TextBlock Text="-twrepeat* waymarkfile.ini  → Loops waypoints infinitely" FontFamily="Consolas" FontSize="11.5" Foreground="#a1a1aa" />
                                        <TextBlock Text="-cl  → Copies current coordinates to clipboard" FontFamily="Consolas" FontSize="11.5" Foreground="#a1a1aa" />
                                        <TextBlock Text="-d / -e  → Disable or enable all hacks" FontFamily="Consolas" FontSize="11.5" Foreground="#a1a1aa" />
                                        <TextBlock Text="-esp / -rad  → Toggle ESP or Radar windows" FontFamily="Consolas" FontSize="11.5" Foreground="#a1a1aa" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{StaticResource BorderBrush}" Cursor="SizeWE" />

            <!-- RIGHT: LIVE CONFIG PREVIEW & LINE INSPECTOR -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LIVE CONFIG.TXT PREVIEW" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Real-time 55-line output synchronized with your changes" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- View Toggle -->
                        <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="55 Lines Verified" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                        </Border>
                    </Grid>

                    <!-- Live Code Editor / Text Viewer -->
                    <TabControl Grid.Row="1">
                        <TabItem Header="Line-Numbered View">
                            <TextBox Text="{Binding LineNumberedPreview, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="11.5"
                                     Background="#0c121e"
                                     Foreground="#e2e8f0"
                                     BorderThickness="0"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Padding="10" />
                        </TabItem>
                        <TabItem Header="Raw config.txt Output">
                            <TextBox Text="{Binding RawConfigPreview, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="12"
                                     Background="#0c121e"
                                     Foreground="#38bdf8"
                                     BorderThickness="0"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Padding="10" />
                        </TabItem>
                    </TabControl>

                    <!-- Bottom Preview Action Bar -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Content="📋 Copy All Lines" Command="{Binding CopyToClipboardCommand}" Margin="0,0,4,0" />
                        <Button Grid.Column="1" Content="💾 Save config.txt" Command="{Binding SaveConfigCommand}" Style="{StaticResource AccentButtonStyle}" Margin="4,0,0,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
