<UserControl x:Class="SpeederConfigApp.Controls.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="75" d:DesignWidth="360">
    <Border Background="#1f1f23" BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="6" Padding="8">
        <StackPanel>
            <!-- Primary Row: Color Preview Badge + Decimal Input + Hex Display + Expand/Pick Toggle -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Color Swatch Badge -->
                <Border x:Name="ColorBadge"
                        Grid.Column="0"
                        Width="30" Height="30"
                        CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="#52525b"
                        Background="Red"
                        ToolTip="Visual Color Preview (Click preset below or adjust RGB)" />

                <!-- Decimal Value Input -->
                <TextBox x:Name="DecInput"
                         Grid.Column="1"
                         Margin="8,0,0,0"
                         Height="30"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextChanged="DecInput_TextChanged"
                         ToolTip="Raw Decimal RGB integer (as expected in config.txt)" />

                <!-- Hex Display -->
                <TextBlock x:Name="HexDisplay"
                           Grid.Column="2"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           Foreground="#a1a1aa"
                           Text="#FF0000"
                           FontSize="12" />

                <!-- Toggle RGB sliders expander button -->
                <Button x:Name="ToggleExpandBtn"
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        Height="30"
                        Padding="8,0"
                        Content="Custom RGB ▼"
                        FontSize="11"
                        Click="ToggleExpandBtn_Click" />
            </Grid>

            <!-- Quick Swatches Row -->
            <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                <TextBlock Text="Presets: " VerticalAlignment="Center" FontSize="11" Foreground="#71717a" Margin="0,0,4,0" />
                <Button Width="18" Height="18" Margin="2" Background="#FF0000" BorderBrush="#27272a" ToolTip="Red (16711680)" Tag="16711680" Click="Preset_Click" />
                <Button Width="18" Height="18" Margin="2" Background="#00FF00" BorderBrush="#27272a" ToolTip="Pure Green (65280)" Tag="65280" Click="Preset_Click" />
                <Button Width="18" Height="18" Margin="2" Background="#00EA60" BorderBrush="#27272a" ToolTip="Mounted Green (60000)" Tag="60000" Click="Preset_Click" />
                <Button Width="18" Height="18" Margin="2" Background="#027100" BorderBrush="#27272a" ToolTip="Forest Green (160000)" Tag="160000" Click="Preset_Click" />
                <Button Width="18" Height="18" Margin="2" Background="#01D400" BorderBrush="#27272a" ToolTip="Light Green (120000)" Tag="120000" Click="Preset_Click" />
                <Button Width="18" Height="18" Margin="2" Background="#0000FF" BorderBrush="#27272a" ToolTip="Blue (255)" Tag="255" Click="Preset_Click" />
                <Button Width="18" Height="18" Margin="2" Background="#FFFF00" BorderBrush="#27272a" ToolTip="Yellow (16776960)" Tag="16776960" Click="Preset_Click" />
                <Button Width="18" Height="18" Margin="2" Background="#FF8800" BorderBrush="#27272a" ToolTip="Orange (16746496)" Tag="16746496" Click="Preset_Click" />
                <Button Width="18" Height="18" Margin="2" Background="#373737" BorderBrush="#27272a" ToolTip="Radar BG (3618615)" Tag="3618615" Click="Preset_Click" />
                <Button Width="18" Height="18" Margin="2" Background="#FFFFFF" BorderBrush="#27272a" ToolTip="White (16777215)" Tag="16777215" Click="Preset_Click" />
                <Button Width="18" Height="18" Margin="2" Background="#000000" BorderBrush="#71717a" ToolTip="Hidden / Disabled (0)" Tag="0" Click="Preset_Click" />
            </WrapPanel>

            <!-- Collapsible RGB Sliders -->
            <StackPanel x:Name="SlidersPanel" Visibility="Collapsed" Margin="0,8,0,0">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="35" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="R" Foreground="#ef4444" FontWeight="Bold" VerticalAlignment="Center" />
                    <Slider x:Name="SliderR" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" Margin="4,0" />
                    <TextBlock x:Name="TextR" Grid.Column="2" Text="255" Foreground="#f4f4f5" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="35" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="G" Foreground="#22c55e" FontWeight="Bold" VerticalAlignment="Center" />
                    <Slider x:Name="SliderG" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" Margin="4,0" />
                    <TextBlock x:Name="TextG" Grid.Column="2" Text="0" Foreground="#f4f4f5" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="35" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="B" Foreground="#3b82f6" FontWeight="Bold" VerticalAlignment="Center" />
                    <Slider x:Name="SliderB" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" Margin="4,0" />
                    <TextBlock x:Name="TextB" Grid.Column="2" Text="0" Foreground="#f4f4f5" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
